{
  "manifest_version": 3,
  "name": "PhishGuard – Phishing & Risky Site Detector",
  "short_name": "PhishGuard",
  "version": "1.0.0",
  "description": "Scans every page for phishing red flags (look-alike domains, insecure password fields, hidden iframes, suspicious redirects) and warns you with a risk score.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "PhishGuard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "tabs", "webNavigation", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
